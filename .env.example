# --- Base de datos ---
# Dev local sin Docker: PGlite (Postgres embebido en un directorio local)
DATABASE_DRIVER=pglite
PGLITE_DIR=./.pgdata
# Produccion (Neon / cualquier Postgres): descomenta y usa
# DATABASE_DRIVER=postgres
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# --- Identificacion ante las APIs publicas (obligatorio en Radio Browser) ---
USER_AGENT=WorldTune/0.1

# --- Web ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Relay para emisoras que solo sirven http:// (mixed content). Vacio = desactivado
NEXT_PUBLIC_RELAY_ENABLED=true
